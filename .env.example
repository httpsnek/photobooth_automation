# ════════════════════════════════════════════════════════════════
#  InstaBOX kiosk — per-booth config. Copy to .env and fill in.
#  The same code runs on every booth; only this file changes.
# ════════════════════════════════════════════════════════════════

# ─── This booth's identity ──────────────────────────────────────
BOOTH_ID=booth-001                 # unique per machine (a-z 0-9 - _), used in DB/logs/invoices
BOOTH_NAME=InstaBOX ТРЦ Ocean Plaza
SUPPORT_PHONE=+380 68 123 45 67    # shown on error screens

# ─── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Public URL of this backend (only needed for the Monobank webhook accelerator;
# polling works without it).
PUBLIC_BASE_URL=
# Token that protects /admin/* (pause, resume, paper-reset). Leave empty to disable.
ADMIN_TOKEN=

# ─── Pricing ────────────────────────────────────────────────────
PRICE_UAH=150
CURRENCY=UAH
SHOTS=4

# ─── Acquirer ───────────────────────────────────────────────────
PAYMENT_PROVIDER=mock             # mock | monobank
BANK_TOKEN=                       # Monobank: X-Token from https://api.monobank.ua ("Еквайринг")
MERCHANT_ID=                      # optional, if your acquirer needs it
MONOBANK_API_BASE=https://api.monobank.ua
INVOICE_TTL_SEC=180
POLL_INTERVAL_SEC=1.5

# ─── dslrBooth trigger ──────────────────────────────────────────
DSLRBOOTH_TRIGGER=hotkey          # hotkey (basic, keypress) | rest (Pro REST API)
DSLRBOOTH_HOTKEY=space
DSLRBOOTH_API_URL=http://localhost:1500/api/take_photo
DSLRBOOTH_API_PASSWORD=

# ─── Session timing — MEASURE on the real booth with a stopwatch ─
SESSION_DURATION_SEC=35           # from trigger to last shot done
PRINT_DURATION_SEC=25             # from last shot to strip in the tray
DONE_DURATION_SEC=6
TRIGGER_RETRIES=3
TRIGGER_RETRY_PAUSE_SEC=2

# ─── Telegram alerts to the owner ───────────────────────────────
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
DAILY_SUMMARY_HOUR=23

# ─── Thermal paper ──────────────────────────────────────────────
PAPER_CAPACITY=700               # prints per roll; 0 disables tracking
PAPER_WARN_PRINTS_LEFT=60        # alert the owner when this many are left
# (after replacing the roll: POST /admin/paper-reset?token=...)

# ─── Fleet heartbeat (optional) ─────────────────────────────────
# If set, the booth POSTs its status JSON here every interval — point it at a
# simple collector / Google Apps Script / n8n to get a live fleet dashboard.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SEC=300

# ─── Storage (local, per booth) ────────────────────────────────
DATA_DIR=data                    # -> data/<BOOTH_ID>.db ; logs -> logs/<BOOTH_ID>.log
DB_PATH=                         # explicit override (rarely needed)

# ─── Branded video layer (optional; HTML screens by default) ────
ATTRACT_VIDEO=                   # e.g. waiting.mp4 in frontend/static/media/
PAID_VIDEO=
QR_LEFT_PCT=50.6
QR_TOP_PCT=56.46
QR_SIZE_PCT=52.5
QR_HEIGHT_PCT=50.5
QR_RADIUS_PCT=3.6

# ─── Dev-only switches (keep 0 in production) ──────────────────
FAKE_TRIGGER_OK=0                # 1 = pretend the camera fired
MOCK_FAIL=0                      # 1 = simulate an acquirer outage
