# ════════════════════════════════════════════════════════════════
#  InstaBOX kiosk — per-booth config. Copy to .env and fill in.
#  The same code runs on every booth; only this file changes.
# ════════════════════════════════════════════════════════════════

# ─── This booth's identity ──────────────────────────────────────
BOOTH_ID=booth-001                 # unique per machine (a-z 0-9 - _), used in DB/logs/invoices
BOOTH_NAME=InstaBOX ТРЦ Ocean Plaza
SUPPORT_PHONE=+380 68 123 45 67    # shown on error screens

# ─── Server ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Public URL of this backend (only needed for the Monobank webhook accelerator;
# polling works without it).
PUBLIC_BASE_URL=
# Token that protects /admin/* (pause, resume, paper-reset). Leave empty to disable.
ADMIN_TOKEN=

# ─── Pricing ────────────────────────────────────────────────────
PRICE_UAH=150
CURRENCY=UAH
SHOTS=4

# ─── Acquirer ───────────────────────────────────────────────────
PAYMENT_PROVIDER=mock             # mock | monobank
BANK_TOKEN=                       # Monobank: X-Token from https://api.monobank.ua ("Еквайринг")
MERCHANT_ID=                      # optional, if your acquirer needs it
MONOBANK_API_BASE=https://api.monobank.ua
INVOICE_TTL_SEC=180
POLL_INTERVAL_SEC=1.5

# ─── dslrBooth trigger ──────────────────────────────────────────
DSLRBOOTH_TRIGGER=hotkey          # hotkey (basic, keypress) | rest (Pro REST API)
DSLRBOOTH_HOTKEY=space
DSLRBOOTH_API_URL=http://localhost:1500/api/take_photo
DSLRBOOTH_API_PASSWORD=
# hotkey mode has no feedback — before selling a session the backend confirms
# dslrBooth is actually running (a blind keypress into nothing = paid, no photos).
DSLRBOOTH_PROC_NAMES=dslrBooth.exe,dslrBooth
DSLRBOOTH_REQUIRE_FOREGROUND=0    # 1 = also require the dslrBooth window to be active

# ─── dslrBooth Trigger events (Pro) — screens follow the camera, not a timer ─
# dslrBooth Pro → Settings › General › Triggers → set the URL to:
#   http://<this-pc>:8000/dslrbooth/event?token=<DSLRBOOTH_EVENT_TOKEN>
# dslrBooth appends &event_type=…  on session_start / countdown_start /
# capture_start / printing / session_end. The tablet's 3·2·1 then matches the
# real camera. With this OFF, the SESSION_DURATION_SEC / PRINT_DURATION_SEC
# timers below drive the screens instead (fine for basic dslrBooth).
DSLRBOOTH_EVENTS_ENABLED=0
DSLRBOOTH_EVENT_TOKEN=            # any random string; rejects spoofed calls
BOOTH_WATCHDOG_SEC=90            # no event for this long after start → refund

# ─── Session timing ─────────────────────────────────────────────
# With events ON these are only a safety fallback. With events OFF they drive
# the screens — MEASURE once on the real booth with a stopwatch.
SESSION_DURATION_SEC=35           # from trigger to last shot done
PRINT_DURATION_SEC=25             # from last shot to strip in the tray
DONE_DURATION_SEC=6
GET_READY_SEC=2                   # "Дивіться в камеру!" held before the 3·2·1
SHOT_COUNTDOWN_SEC=3              # the "3·2·1" shown before each photo
TRIGGER_RETRIES=3
TRIGGER_RETRY_PAUSE_SEC=2

# ─── Telegram alerts to the owner ───────────────────────────────
TELEGRAM_ALERTS_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
DAILY_SUMMARY_HOUR=23

# ─── Thermal paper + printer health ────────────────────────────
PAPER_CAPACITY=700               # prints per roll; 0 disables tracking
PAPER_WARN_PRINTS_LEFT=60        # alert the owner when this many are left
# at 0 left the booth stops selling (OUT_OF_SERVICE) until you reset the counter:
# POST /admin/paper-reset?token=...
PRINTER_CHECK_ENABLED=1          # Windows: poll the print queue for jam/offline/paper-out
PRINTER_NAME=                    # exact printer name; empty = the default printer

# ─── Refund resilience (money owed is never dropped) ───────────
# Failed refunds (acquirer/network down at reboot) and late payments on an
# abandoned invoice go into a SQLite queue and are retried with backoff.
WATCH_TTL_SEC=300               # keep polling an abandoned invoice this long
REFUND_RETRY_BASE_SEC=60
REFUND_MAX_ATTEMPTS=12          # after this many, alert "manual intervention" (keeps trying)
PENDING_OPS_INTERVAL_SEC=45

# ─── Fleet heartbeat (optional) ─────────────────────────────────
# If set, the booth POSTs its status JSON here every interval — point it at a
# simple collector / Google Apps Script / n8n to get a live fleet dashboard.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SEC=300

# ─── Storage (local, per booth) ────────────────────────────────
DATA_DIR=data                    # -> data/<BOOTH_ID>.db ; logs -> logs/<BOOTH_ID>.log
DB_PATH=                         # explicit override (rarely needed)

# ─── Branded video layer (optional; HTML screens by default) ────
ATTRACT_VIDEO=                   # e.g. waiting.mp4 in frontend/static/media/
PAID_VIDEO=
QR_LEFT_PCT=50.6
QR_TOP_PCT=56.46
QR_SIZE_PCT=52.5
QR_HEIGHT_PCT=50.5
QR_RADIUS_PCT=3.6

# ─── External watchdog (watchdog.py — restarts a wedged backend) ─
# Probes /health; kills the backend (run.bat then restarts it) if it stops
# answering, or if the FSM freezes in a work state. OUT_OF_SERVICE is never
# "stuck". Defaults are sane — only touch these to tune sensitivity.
WATCHDOG_INTERVAL_SEC=45
WATCHDOG_TIMEOUT_SEC=5
WATCHDOG_FAIL_LIMIT=2            # consecutive no-answers before a restart
WATCHDOG_STUCK_SEC=180          # raised automatically to at least INVOICE_TTL_SEC+120
WATCHDOG_TASKKILL=0             # 1 = always use `taskkill /F /IM python.exe` (blunt)
WATCHDOG_REBOOT_AFTER_KILLS=5   # PC reboot if this many restarts in the window; 0 = never
WATCHDOG_REBOOT_WINDOW_MIN=30

# ─── Dev-only switches (keep 0 in production) ──────────────────
FAKE_TRIGGER_OK=0                # 1 = pretend the camera fired
MOCK_FAIL=0                      # 1 = simulate an acquirer outage
