# ================================================================
#  InstaBOX - налаштування цієї точки
#
#  Заповніть рядки з позначкою  <<< ЗАПОВНИТИ  у першому блоці.
#  Решта вже налаштована - її можна не чіпати.
#
#  Пишіть значення одразу після знака "=", без лапок.
#  Збережіть файл (Ctrl+S) і закрийте Блокнот - встановлення продовжиться.
# ================================================================


# ================  ОБОВ'ЯЗКОВО  =================================

# Токен еквайрингу Monobank (кабінет бізнесу > Еквайринг > X-Token)
BANK_TOKEN=                        # <<< ЗАПОВНИТИ

# Пароль API з dslrBooth (Settings > General > API)
DSLRBOOTH_API_PASSWORD=            # <<< ЗАПОВНИТИ

# Telegram підтримки - показується гостю QR-кодом на екрані помилки.
# Можна @username або посилання t.me/...
SUPPORT_TELEGRAM=                  # <<< ЗАПОВНИТИ

# Скільки відбитків дає один рулон паперу (0 = не рахувати)
PAPER_CAPACITY=400                 # <<< ЗАПОВНИТИ

# Ціна сесії в гривнях. Для першої перевірки поставте 1, потім поверніть 150.
PRICE_UAH=150


# ================  СПОВІЩЕННЯ В TELEGRAM (дуже бажано)  ==========
# Без них ви не дізнаєтесь, що точка зупинилась.
# Після заповнення ОБОВ'ЯЗКОВО натисніть Start у вашого бота.
TELEGRAM_ALERTS_BOT_TOKEN=         # токен бота від @BotFather
TELEGRAM_ADMIN_CHAT_ID=            # ваш числовий chat id (дізнатись: @userinfobot)


# ================  НАЗВА ТОЧКИ  ==================================
# BOOTH_NAME видно у виписці банку, у сповіщеннях і в заголовку вікна кіоску.
BOOTH_NAME=InstaBOX
# BOOTH_ID - латиницею, унікальний для кожної кабінки
BOOTH_ID=kiosk-01
SUPPORT_PHONE=                     # телефон підтримки текстом (можна лишити порожнім)


# ================  ДАЛІ МОЖНА НЕ ЧІПАТИ  =========================

# --- Генеруються автоматично під час встановлення ---
ADMIN_TOKEN=
DSLRBOOTH_EVENT_TOKEN=

# --- Оплата ---
PAYMENT_PROVIDER=monobank
MERCHANT_ID=
MONOBANK_API_BASE=https://api.monobank.ua
CURRENCY=UAH
INVOICE_TTL_SEC=180
POLL_INTERVAL_SEC=1.5

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=

# --- dslrBooth ---
# У dslrBooth > Settings > General > Triggers вписати:
#   http://127.0.0.1:8000/dslrbooth/event
DSLRBOOTH_TRIGGER=rest
DSLRBOOTH_API_URL=http://localhost:1500/api/take_photo
DSLRBOOTH_EVENTS_ENABLED=1
DSLRBOOTH_HOTKEY=space
DSLRBOOTH_PROC_NAMES=dslrBooth.exe,dslrBooth,LumaBooth.exe,LumaBooth
# НЕ СТАВИТИ 1: це перевірка, а не команда - з одиницею точка не продасть жодної сесії
DSLRBOOTH_REQUIRE_FOREGROUND=0
SHOTS=4
BOOTH_WATCHDOG_SEC=120
# скільки збоїв камери поспіль - і точка зупиняє продаж, а не бере гроші далі
BOOTH_FAIL_LIMIT=2
BOOTH_FAIL_COOLDOWN_SEC=900

# --- Сенсорний екран: Chrome і dslrBooth по черзі ---
WINDOW_SWITCH_ENABLED=1
KIOSK_WINDOW_TITLE=
KIOSK_PROC_NAMES=chrome.exe,msedge.exe
WINDOW_RAISE_RETRIES=3
DISPLAY_MIN_COUNT=1
SCREEN_GUARD_SEC=4
SCREEN_GUARD_FRESH_SEC=180

# --- Тайминги (запасний варіант, якщо події з dslrBooth не приходять) ---
SESSION_DURATION_SEC=35
PRINT_DURATION_SEC=25
DONE_DURATION_SEC=6
GET_READY_SEC=2
SHOT_COUNTDOWN_SEC=3
TRIGGER_RETRIES=3
TRIGGER_RETRY_PAUSE_SEC=2

# --- Принтер ---
PAPER_WARN_PRINTS_LEFT=60
PRINTER_CHECK_ENABLED=1
PRINTER_NAME=

# --- Сповіщення ---
DAILY_SUMMARY_HOUR=23

# --- Повернення коштів (борг ніколи не губиться) ---
WATCH_TTL_SEC=300
REFUND_RETRY_BASE_SEC=60
REFUND_MAX_ATTEMPTS=12
PENDING_OPS_INTERVAL_SEC=45

# --- Сховище ---
DATA_DIR=data
DB_PATH=

# --- Необов'язкове ---
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SEC=300
ATTRACT_VIDEO=
PAID_VIDEO=
QR_LEFT_PCT=50.6
QR_TOP_PCT=56.46
QR_SIZE_PCT=52.5
QR_HEIGHT_PCT=50.5
QR_RADIUS_PCT=3.6

# --- Зовнішній watchdog ---
WATCHDOG_INTERVAL_SEC=45
WATCHDOG_TIMEOUT_SEC=5
WATCHDOG_FAIL_LIMIT=2
WATCHDOG_STUCK_SEC=180
WATCHDOG_TASKKILL=0
WATCHDOG_REBOOT_AFTER_KILLS=5
WATCHDOG_REBOOT_WINDOW_MIN=30

# --- Тільки для розробки (на точці завжди 0) ---
FAKE_TRIGGER_OK=0
MOCK_FAIL=0
