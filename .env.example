# ─── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Public URL of the backend as seen from the internet (only needed if you
# enable the Monobank webhook accelerator; polling works without it).
PUBLIC_BASE_URL=

# ─── Pricing ──────────────────────────────────────────────
PRICE_UAH=150
CURRENCY=UAH
SHOTS=4

# ─── Payment provider: mock | monobank ────────────────────
PAYMENT_PROVIDER=mock
MONOBANK_TOKEN=
MONOBANK_API_BASE=https://api.monobank.ua
INVOICE_TTL_SEC=180
POLL_INTERVAL_SEC=1.5

# ─── dslrBooth trigger: hotkey | rest ─────────────────────
# hotkey  -> emulates a keypress (basic dslrBooth, no Pro). Windows only.
# rest    -> calls the dslrBooth Pro REST API.
DSLRBOOTH_TRIGGER=hotkey
DSLRBOOTH_HOTKEY=space
DSLRBOOTH_REST_URL=http://localhost:1500/api/take_photo
DSLRBOOTH_API_PASSWORD=

# ─── Session timing (measure once on the real booth) ──────
SESSION_DURATION_SEC=35
PRINT_DURATION_SEC=25
DONE_DURATION_SEC=6

# ─── Session flow tuning ─────────────────────────────────
TRIGGER_RETRIES=3
TRIGGER_RETRY_PAUSE_SEC=2

# ─── Dev-only switches (keep 0 in production) ─────────────
# FAKE_TRIGGER_OK=1 -> pretend the booth trigger always succeeds (no dslrBooth needed)
# MOCK_FAIL=1       -> mock payment provider raises on create -> OUT_OF_SERVICE screen
FAKE_TRIGGER_OK=0
MOCK_FAIL=0

# ─── Telegram alerts to the owner (optional) ──────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_SUMMARY_HOUR=23

# ─── Storage ──────────────────────────────────────────────
DB_PATH=photobooth.db
