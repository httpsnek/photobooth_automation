* text=auto eol=lf

# Windows scripts must be CRLF or cmd.exe mis-parses labels / if-blocks
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.py   text eol=lf
*.sh   text eol=lf

# never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff2 binary
*.mp4  binary
*.zip  binary
